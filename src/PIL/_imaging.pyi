from collections.abc import Sequence
from typing import Any, overload

from ._typing import Buffer

class ImagingCore:
    def __getitem__(self, index: int) -> float | tuple[int, ...] | None: ...
    def __getattr__(self, name: str) -> Any: ...

class ImagingFont:
    def __getattr__(self, name: str) -> Any: ...

class ImagingDraw:
    def __getattr__(self, name: str) -> Any: ...

class PixelAccess:
    def __getitem__(self, xy: tuple[int, int]) -> float | tuple[int, ...]: ...
    def __setitem__(
        self, xy: tuple[int, int], color: float | tuple[int, ...]
    ) -> None: ...

class ImagingDecoder:
    def __getattr__(self, name: str) -> Any: ...

class ImagingEncoder:
    def __getattr__(self, name: str) -> Any: ...

class _Outline:
    def close(self) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

class _Path:
    def transform(
        self,
        transform: tuple[float, float, float, float, float, float],
        wrap: float = 0,
    ) -> None: ...
    @overload
    def __getitem__(self, i: int) -> tuple[float, float]: ...
    @overload
    def __getitem__(self, i: slice) -> list[tuple[float, float]]: ...
    def __getattr__(self, name: str) -> Any: ...

def font(image: ImagingCore, glyphdata: bytes) -> ImagingFont: ...
def outline() -> _Outline: ...
def path(
    data: int | _Path | Buffer | Sequence[float] | Sequence[list[float]],
) -> _Path: ...
def __getattr__(name: str) -> Any: ...
